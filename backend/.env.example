# Backend Configuration

# Debug mode
DEBUG=False

# Database (SQLite for local, update for production)
DATABASE_URL=sqlite:///./sentinel.db

# ML model paths (adjust after verified training artifacts exist)
YOLO_MODEL_PATH=../ml/artifacts/best.pt
XGBOOST_MODEL_PATH=../ml/artifacts/risk_model.json

# Upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes

# YOLO Inference
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45

# API settings
API_TITLE=Sentinel AI Backend
API_VERSION=1.0.0

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://127.0.0.1:5173"]
